{
  "name": "meupdf",
  "version": "1.0.1",
  "private": true,
  "description": "MeuPDF — todas as ferramentas de PDF num app local. Nenhum arquivo sai do computador.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node src/server.js",
    "app": "node src/server.js --app",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-timeout=300000 \"test/*.test.js\"",
    "ocr": "node scripts/baixar-ocr.js",
    "icones": "node scripts/gerar-icones.js",
    "postinstall": "node scripts/baixar-ocr.js --silencioso",
    "desktop": "electron .",
    "instalador": "electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Ihago Martins (https://www.instagram.com/ihagomartins1/)",
  "license": "MIT",
  "homepage": "https://github.com/ihagoxd/MeuPDF#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihagoxd/MeuPDF.git"
  },
  "bugs": {
    "url": "https://github.com/ihagoxd/MeuPDF/issues"
  },
  "keywords": [
    "pdf",
    "ocr",
    "juntar-pdf",
    "comprimir-pdf",
    "assinar-pdf",
    "tarjar",
    "lgpd",
    "electron",
    "windows",
    "pt-br"
  ],
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.8.1",
    "express": "^4.21.2",
    "fflate": "^0.8.2",
    "htm": "^3.1.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "4.10.38",
    "preact": "^10.26.0",
    "qrcode-generator": "^2.0.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.ihagomartins.meupdf",
    "productName": "MeuPDF",
    "copyright": "Ihago Martins",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "vendor/**",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/types/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icones/meupdf.ico",
      "artifactName": "MeuPDF-Instalador-${version}.${ext}",
      "executableName": "MeuPDF"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MeuPDF",
      "uninstallDisplayName": "MeuPDF",
      "installerIcon": "public/icones/meupdf.ico",
      "uninstallerIcon": "public/icones/meupdf.ico",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}

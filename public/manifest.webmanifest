{
  "name": "XdPDF",
  "short_name": "XdPDF",
  "description": "Todas as ferramentas de PDF num app local. Nenhum arquivo sai do computador.",
  "lang": "pt-BR",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0d0e12",
  "theme_color": "#e8383d",
  "icons": [
    { "src": "/icones/xdpdf.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icones/xdpdf-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icones/xdpdf-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icones/xdpdf-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": { "application/pdf": [".pdf"] }
    }
  ]
}
